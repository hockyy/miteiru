{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Miteiru",
  "version": "../package.json",
  "identifier": "id.hocky.miteiru",
  "build": {
    "frontendDist": "../app",
    "devUrl": "http://localhost:8888",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Miteiru",
        "url": "home/",
        "width": 1000,
        "height": 600,
        "minWidth": 640,
        "minHeight": 400,
        "dragDropEnabled": true,
        "create": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../resources/icon.png",
      "../resources/icon.icns",
      "../resources/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Watch videos with interactive subtitles to learn Japanese, Chinese, Cantonese and Vietnamese.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libmpv2 | libmpv1"
        ]
      }
    }
  }
}
