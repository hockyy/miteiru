{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Miteiru",
  "version": "../package.json",
  "identifier": "id.hocky.miteiru",
  "build": {
    "frontendDist": "../app",
    "devUrl": "http://localhost:8888",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Miteiru",
        "url": "home/",
        "width": 1000,
        "height": 600,
        "minWidth": 640,
        "minHeight": 400,
        "dragDropEnabled": true,
        "create": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' https://www.youtube.com https://s.ytimg.com",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "frame-src": "https://www.youtube.com https://www.youtube-nocookie.com",
        "connect-src": "'self' ipc: http://ipc.localhost https://vision.googleapis.com https://lrclib.net https://openrouter.ai",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../resources/icon.png",
      "../resources/icon.icns",
      "../resources/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Watch videos with interactive subtitles to learn Japanese, Chinese, Cantonese and Vietnamese.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": false
    },
    "linux": {
      "deb": {
        "depends": [
          "libmpv2 | libmpv1"
        ],
        "recommends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
